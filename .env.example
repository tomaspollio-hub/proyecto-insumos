# Copiar a .env para desarrollo local (nunca commitear .env)

# Clave secreta JWT — cambiar en producción
ISUMOS_SECRET=dev-secret-change-in-prod

# Directorio persistente para DB e imágenes (Railway: /data)
# Si no se define, usa server/ localmente
# DATA_DIR=/data

# Puerto (Railway lo inyecta automáticamente)
# PORT=8000

# Entorno
FLASK_ENV=production
